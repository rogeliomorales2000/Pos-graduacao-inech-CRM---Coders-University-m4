# Conexão do banco local usada por `bun run db:migrate`.
# O default (sem variável) já aponta para o Postgres do docker-compose.
# Para sobrescrever, exporte DB_URL antes de rodar db:migrate.
DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# URL do cliente, usada nos links de email (confirmação/reset).
APP_URL=http://localhost:5173

# Email (auth): provider selecionado por EMAIL_PROVIDER.
# - console (default em dev): apenas loga o conteúdo do email (sem credenciais).
# - mailtrap: requer MAILTRAP_API_TOKEN + MAILTRAP_SANDBOX_ID (id do sandbox/inbox).
# - resend: requer RESEND_API_KEY (default em produção).
# EMAIL_PROVIDER=mailtrap
# RESEND_API_KEY=
# MAILTRAP_API_TOKEN=
# MAILTRAP_SANDBOX_ID=
# EMAIL_FROM=Intech CRM <no-reply@intech.local>

# Apps (a preencher conforme features futuras):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=