{
  "name": "coder-university-m4",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,html}\"",
    "check-types": "turbo run check-types",
    "types:check": "turbo run check-types",
    "code:fix": "turbo run lint:fix && prettier --write \"**/*.{ts,tsx,md,json,css,html}\"",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "commitlint": "commitlint",
    "commit-and-push": "bun scripts/commit-and-push.mjs",
    "prepare": "lefthook install",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:migrate": "supabase db push --db-url \"${DB_URL:-postgresql://postgres:postgres@localhost:54322/postgres}?sslmode=disable\""
  },
  "devDependencies": {
    "@babel/preset-typescript": "8.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.14",
    "prettier": "3.9.6",
    "supabase": "^2.117.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
